{
  "name": "highlight-plus",
  "version": "1.0.3",
  "description": "A React component that extends react-highlight to highlight search terms within syntax-highlighted code.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./styles/style.css": "./dist/esm/styles/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc && node -e \"require('fs').cpSync('src/styles','dist/esm/styles',{recursive:true})\"",
    "build:cjs": "tsc --module CommonJS --outDir dist/cjs && node -e \"require('fs').cpSync('src/styles','dist/cjs/styles',{recursive:true})\"",
    "prepublishOnly": "npm run build",
    "release": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pranav-Rustagi/highlight-plus.git"
  },
  "keywords": [
    "highlight.js",
    "react",
    "highlight",
    "react-highlight",
    "code",
    "syntax",
    "syntax-highlighting",
    "search",
    "typescript"
  ],
  "author": "Pranav Rustagi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Pranav-Rustagi/highlight-plus/issues"
  },
  "homepage": "https://github.com/Pranav-Rustagi/highlight-plus#readme",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-highlight": "^0.12.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-highlight": "^0.15.0"
  }
}
